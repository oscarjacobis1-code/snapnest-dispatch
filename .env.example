PORT=8787
NODE_ENV=development
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_TENANT_SLUG=demo-base
DISPATCH_REQUIRE_AUTH=true
WHATSAPP_ADAPTER_KEY=

# Optional until PTT is enabled. Keep API secret server-side only.
PTT_PROVIDER=livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional road-ETA ranking. If MAPBOX_ACCESS_TOKEN is blank, dispatch falls back
# to the existing proximity/fairness engine. Keep the token server-side only.
MAPBOX_ACCESS_TOKEN=
MAPBOX_ROUTING_PROFILE=mapbox/driving-traffic
